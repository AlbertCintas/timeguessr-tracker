{
  "manifest_version": 3,
  "name": "Timeguessr Club \u2014 automatic receipts",
  "version": "1.1.1",
  "description": "Automatically save your completed Timeguessr games to the group scoreboard.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://timeguessr.com/*",
    "https://www.timeguessr.com/*",
    "https://xymaqcuhpmjimfbwpenr.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Timeguessr Club",
    "default_icon": {
      "16": "icons/club-16.png",
      "32": "icons/club-32.png",
      "48": "icons/club-48.png",
      "128": "icons/club-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://timeguessr.com/*", "https://www.timeguessr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "140",
  "icons": {
    "16": "icons/club-16.png",
    "32": "icons/club-32.png",
    "48": "icons/club-48.png",
    "128": "icons/club-128.png"
  },
  "homepage_url": "https://albertcintas.github.io/timeguessr-tracker/"
}
