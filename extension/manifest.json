{
  "manifest_version": 3,
  "name": "Timeguessr Club — automatic receipts",
  "version": "1.0.0",
  "description": "Automatically save your completed Timeguessr games to the group scoreboard.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://timeguessr.com/*",
    "https://www.timeguessr.com/*",
    "https://xymaqcuhpmjimfbwpenr.supabase.co/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Timeguessr Club"
  },
  "content_scripts": [
    {
      "matches": ["https://timeguessr.com/*", "https://www.timeguessr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
